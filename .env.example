# Application
APP_NAME=Trinetra Backend
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Security
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Database
DATABASE_URL=sqlite:///./backend/data/trinetra.db

# AI / Vision
YOLO_MODEL=yolo11n.pt
DETECTION_CONFIDENCE=0.50

# Video
MAX_CAMERAS=4
FRAME_SKIP=2

# Demo
DEMO_MODE=true